# Copia este archivo a .env.local (local) o carga los valores en Cloudflare.
# Nunca subas claves reales al repositorio.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Supabase (Project Settings → API Keys). La "publishable key" es pública.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…): solo en el servidor, para guardar pedidos. En
# Cloudflare se carga como tipo "Secret" (encriptado), nunca como texto.
SUPABASE_SECRET_KEY=

# Webpay Plus. Sin estas variables se usa el ambiente de INTEGRACIÓN con las
# claves públicas de prueba de Transbank (no cobra de verdad).
# Al recibir el código de comercio: WEBPAY_AMBIENTE=produccion + las dos claves.
WEBPAY_AMBIENTE=integracion
WEBPAY_CODIGO_COMERCIO=
WEBPAY_API_KEY=

# Correo de confirmación de compra (Resend). Sin RESEND_API_KEY no se envía.
RESEND_API_KEY=
CORREO_REMITENTE=Vapeur <onboarding@resend.dev>
