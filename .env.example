# Copia este archivo a .env.local (local) o carga los valores en Cloudflare.
# Nunca subas claves reales al repositorio.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Supabase (Project Settings → API). La "publishable key" es pública; la
# "secret key" NUNCA va aquí ni en Cloudflare como variable visible.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Chilexpress (developers.wschilexpress.com → suscribirse a Cobertura,
# Cotizador y Envíos). Sin claves, la tienda usa la tarifa estimada por zona.
# CHILEXPRESS_AMBIENTE=produccion solo con Cuenta Empresa; vacío = pruebas.
CHILEXPRESS_AMBIENTE=
CHILEXPRESS_CLAVE_COBERTURA=
CHILEXPRESS_CLAVE_COTIZADOR=
CHILEXPRESS_CLAVE_ENVIOS=
# Código de cobertura de la comuna de origen (Santiago Centro = STGO)
CHILEXPRESS_ORIGEN=STGO
# Número de Tarjeta Cliente Chilexpress (TCC), para crear envíos
CHILEXPRESS_TCC=
